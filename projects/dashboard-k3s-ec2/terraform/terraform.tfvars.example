# Copy to terraform.tfvars (gitignored) and edit. Placeholders only.
region        = "us-east-1"
owner         = "lab"
domain_name   = "example.com"
site_hostname = "dash.example.com"

# Route 53 domain registration creates a hosted zone automatically. Paste its ID here:
existing_hosted_zone_id = "Z0123456789EXAMPLE"

instance_type  = "t4g.small"
install_argocd = true
enable_waf     = false

# Flip to true + `terraform apply` right before teardown so destroy can empty the bucket.
bucket_force_destroy = false
