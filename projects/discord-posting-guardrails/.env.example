# Discord posting (never commit a real .env)
NDTL_WEBHOOK_URL=https://discord.com/api/webhooks/${DISCORD_WEBHOOK_ID}/${DISCORD_WEBHOOK_TOKEN}
# Optional: path to a file containing the same URL (alternative to NDTL_WEBHOOK_URL)
# NDTL_WEBHOOK_FILE=/path/to/webhook_url
NDTL_DISCORD_CONFIG=./poster/config.json
NDTL_PIPELINE_ROOT=./pipeline
NDTL_POST_WEBHOOK=./poster/post_webhook.py
# Optional roots for the read-only guard scanner (colon-separated)
# NDTL_GUARD_ROOTS=.
